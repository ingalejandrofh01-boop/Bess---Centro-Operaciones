# Forzar LF en todos los archivos de texto — evita CRLF en Windows
* text=auto eol=lf

# Archivos especificos
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binarios — no tocar
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff binary
*.woff2 binary
